{
    "name": "gugugaga",
    "displayName": "Gugugaga",
    "description": "Syntax highlighting and execution support for the Gugu programming language",
    "version": "0.1.1",
    "publisher": "SioHaft",
    "icon": "icon.png",
    "main": "./extension.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/siohaft/gugugaga.git"
    },
    "homepage": "https://github.com/siohaft/gugugaga",
    "bugs": {
        "url": "https://github.com/siohaft/gugugaga/issues"
    },
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "gugu",
                "aliases": [
                    "Gugu",
                    "gugu"
                ],
                "extensions": [
                    ".gugu"
                ],
                "icon": {
                    "light": "./icon.png",
                    "dark": "./icon.png"
                },
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "gugu",
                "scopeName": "source.gugu",
                "path": "./syntaxes/gugu.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "gugugaga.runFile",
                "title": "Run Gugu File",
                "icon": "$(play)"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "gugugaga.runFile",
                    "when": "editorLangId == gugu",
                    "group": "navigation"
                }
            ]
        }
    }
}